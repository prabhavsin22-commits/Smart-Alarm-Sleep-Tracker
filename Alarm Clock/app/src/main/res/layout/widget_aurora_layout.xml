<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E610111A"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AuraRise"
            android:textColor="#FFB347"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sleep_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E1C40"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Sleep 89%"
            android:textColor="#D7BAFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="06:30 AM"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_alarm_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ambient Sunrise (15m) • Math Task"
        android:textColor="#A0A3BD"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_quick_nap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FF9100"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="⚡ 20m Nap"
            android:textColor="#12131C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tap_to_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Tap to open app"
            android:textColor="#6E728F"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
